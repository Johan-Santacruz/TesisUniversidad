SIAD_SIAD_ENV=development
SIAD_DATABASE_URL=sqlite:///./data/siad.db
SIAD_STORAGE_DIR=./data/storage
SIAD_FRONTEND_ORIGIN=http://localhost:5173

# Ambos valores deben ser base64 URL-safe de exactamente 32 bytes.
# Genérelos con: openssl rand -base64 32 | tr '/+' '_-'
SIAD_ENCRYPTION_MASTER_KEY=<base64-32-byte-key>
SIAD_JWT_SECRET_KEY=<base64-32-byte-key>
SIAD_KEY_VERSION=1

SIAD_OPENAI_API_KEY=
SIAD_ANTHROPIC_API_KEY=
SIAD_OPENAI_ANALYSIS_MODEL=gpt-5.6-terra
SIAD_ANTHROPIC_ANALYSIS_MODEL=claude-sonnet-5
SIAD_WHISPER_MODEL=whisper-1

# Los cuatro controles deben estar presentes para admitir testimonios reales.
SIAD_REAL_DATA_ENABLED=false
SIAD_OPENAI_ZDR_CONFIRMED=false
SIAD_ANTHROPIC_ZDR_CONFIRMED=false
SIAD_INSTITUTIONAL_AUTHORIZATION_ID=

SIAD_DEMO_USERS_ENABLED=true
SIAD_DEMO_ADMIN_EMAIL=admin@siad.local
SIAD_DEMO_ADMIN_PASSWORD=Cambiar-Esta-Clave-2026!
