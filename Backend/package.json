{
  "name": "siad-backend",
  "version": "1.0.0",
  "description": "Servicio de transcripción y clasificación de testimonios para SIAD",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch src/index.ts",
    "classifier:install": "python3 -m venv .venv && .venv/bin/python -m pip install --upgrade pip && .venv/bin/python -m pip install -r services/ml_service/requirements.txt",
    "classifier:dev": ".venv/bin/python -m uvicorn services.ml_service.classifier_service:app --host 0.0.0.0 --port 8001",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.52.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.6",
    "tsx": "^4.7.0",
    "typescript": "^5.7.3"
  }
}
