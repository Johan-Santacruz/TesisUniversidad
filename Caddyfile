# El dominio y el certificado los termina el proxy del anfitrión, no esto.
#
# Por eso aquí se sirve HTTP plano y sin redirección, a propósito: si Caddy
# redirigiera a HTTPS, el proxy de delante —que ya entrega por HTTPS— entraría
# en un bucle de redirecciones; y si intentara emitir su propio certificado,
# fallaría siempre, porque los puertos 80 y 443 públicos son del anfitrión.
#
# Caddy se queda como repartidor interno: decide qué va a la API y qué al
# frontend, que es lo que ninguno de los dos sabe hacer por su cuenta.
:80 {
	encode gzip

	# La API va primero: una ruta más específica gana a la del sitio.
	handle /api/* {
		reverse_proxy api:8000 {
			# El análisis emite eventos por SSE. Sin desactivar el búfer, el
			# proxy los retiene y la pantalla de progreso se queda quieta
			# hasta que termina todo.
			flush_interval -1
		}
	}

	handle /health {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:80
	}

	# El testimonio no debe quedar en la caché de nadie por el camino.
	header /api/* Cache-Control "no-store"
}
