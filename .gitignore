# OS
**/.DS_Store

# Vite / local tooling
.vite/

# Dependencies and build outputs
**/node_modules/
**/dist/
**/build/
**/*.tsbuildinfo
Backend/.venv/
frontend/playwright-report/
frontend/test-results/

# Local runtime data
Backend/data/*.db
Backend/data/*.db-*
Backend/data/*.sqlite
Backend/data/*.sqlite-*
.worktrees/

# Environment files
**/.env
**/.env.local
**/.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python caches and notebook checkpoints
**/__pycache__/
**/*.py[cod]
**/.ipynb_checkpoints/

# Respaldos locales de artefactos del clasificador: los pesos .pt pesan 420 MB
# cada uno y GitHub rechaza cualquier archivo de mas de 100 MB. Los .pt ya los
# ignora Backend/.gitignore, pero los joblib de los baselines suman ~47 MB por
# respaldo y sin estas reglas entrarian al historial con un `git add .`.
Backend/ml-artifacts/*-backup/
Backend/ml-artifacts/*.bak-*/

# Videos de prueba descargados. Ya no viven aqui —se movieron fuera del
# repositorio, a donde apunte SENDA_MATERIAL_PRUEBAS— pero las reglas se quedan:
# un script lanzado con una ruta relativa los recrearia, y son cientos de megas.
Backend/prueba-videos/
Backend/prueba-fotograma/
videos-prueba/

# Sesión de YouTube para la ingesta por enlace. Es una sesión de Google viva:
# quien lea este archivo entra a esa cuenta. Nunca al repositorio.
secretos/
*cookies*.txt
