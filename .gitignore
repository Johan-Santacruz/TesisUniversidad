# OS
**/.DS_Store

# Vite / local tooling
.vite/

# Dependencies and build outputs
**/node_modules/
**/dist/
**/build/
**/*.tsbuildinfo
Backend/.venv/
frontend/playwright-report/
frontend/test-results/

# Local runtime data
Backend/data/*.db
Backend/data/*.db-*
Backend/data/*.sqlite
Backend/data/*.sqlite-*
.worktrees/

# Environment files
**/.env
**/.env.local
**/.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python caches and notebook checkpoints
**/__pycache__/
**/*.py[cod]
**/.ipynb_checkpoints/

# Respaldos locales de artefactos del clasificador: los pesos .pt pesan 420 MB
# cada uno y GitHub rechaza cualquier archivo de mas de 100 MB.
Backend/ml-artifacts/*-backup/
