# Copia este archivo como .env EN EL SERVIDOR y rellénalo allí.
# Nunca lo subas a git: .gitignore ya lo impide, y con razón.

# El dominio que apunta a esta máquina. Caddy pide el certificado para él.
SENDA_DOMINIO=senda.casa

# En "production" las cookies de sesión se marcan Secure y /docs deja de
# publicarse. Cualquier otro valor deja ambas cosas abiertas.
SENDA_SENDA_ENV=production

# Genera cada una POR SEPARADO en el servidor, y no reutilices las de tu
# equipo. Si pierdes la de cifrado, lo ya guardado no se recupera:
#   openssl rand -base64 32 | tr '/+' '_-'
SENDA_ENCRYPTION_MASTER_KEY=
SENDA_JWT_SECRET_KEY=
SENDA_KEY_VERSION=1

# Sin claves de proveedor, el caso de demostración recorre las ocho etapas de
# forma determinista y no sale nada del servidor.
SENDA_OPENAI_API_KEY=
SENDA_ANTHROPIC_API_KEY=
SENDA_OPENAI_ANALYSIS_MODEL=gpt-5.6-terra
SENDA_OPENAI_IMAGE_MODEL=gpt-image-2
SENDA_ANTHROPIC_ANALYSIS_MODEL=claude-sonnet-5
SENDA_WHISPER_MODEL=whisper-1

# Voz de la ruta guiada. Sin clave o sin timbre, la ruta se lee con la
# síntesis del navegador y ningún texto del caso sale del dispositivo.
SENDA_ELEVENLABS_API_KEY=
SENDA_ELEVENLABS_VOICE_ID=
SENDA_ELEVENLABS_MODEL=eleven_multilingual_v2

SENDA_VIDEO_RETENTION_DAYS=7

# El administrador de prueba se siembra al arrancar. En un servidor público
# esto significa que cualquiera que lea el README puede entrar: cámbiale la
# contraseña aquí, o pon SENDA_DEMO_USERS_ENABLED=false y crea la cuenta a
# mano. Doce caracteres como mínimo.
SENDA_DEMO_USERS_ENABLED=true
SENDA_DEMO_ADMIN_EMAIL=camilobalanta1@gmail.com
SENDA_DEMO_ADMIN_PASSWORD=

# Traer el testimonio pegando un enlace de YouTube en vez de subir el archivo.
# Apagado a proposito: en un dominio publico, con la cuenta de demostracion a la
# vista, seria un descargador de videos ajeno corriendo con la IP del servidor.
# Encendido, el servidor baja el video en 480p y lo analiza como cualquier otro.
# Descargar de YouTube va contra sus terminos de servicio, y desde la IP de un
# centro de datos la plataforma suele pedir verificacion y devolver un error:
# esto sirve para el material propio de la investigacion, no como servicio.
SENDA_LINK_INGEST_ENABLED=false
SENDA_LINK_INGEST_MAX_SECONDS=1800
